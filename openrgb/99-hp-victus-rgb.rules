# HP Victus / Omen RGB Keyboard & Zones access rules for OpenRGB
SUBSYSTEM=="leds", KERNEL=="hp::kbd_backlight", TAG+="uaccess"
SUBSYSTEM=="leds", KERNEL=="hp-wmi::zone*", TAG+="uaccess"

# Ensure write permissions on sysfs attributes for users
ACTION=="add|change", SUBSYSTEM=="leds", KERNEL=="hp::kbd_backlight", RUN+="/bin/sh -c 'chmod 0666 /sys/class/leds/hp::kbd_backlight/brightness /sys/class/leds/hp::kbd_backlight/multi_intensity 2>/dev/null || true'"
ACTION=="add|change", SUBSYSTEM=="leds", KERNEL=="hp-wmi::zone*", RUN+="/bin/sh -c 'chmod 0666 /sys/class/leds/%k/brightness /sys/class/leds/%k/multi_intensity /sys/class/leds/%k/red /sys/class/leds/%k/green /sys/class/leds/%k/blue 2>/dev/null || true'"
ACTION=="add|change", SUBSYSTEM=="platform", KERNEL=="hp-wmi", RUN+="/bin/sh -c 'chmod -R 0666 /sys/devices/platform/hp-wmi/rgb_zones/* /sys/devices/platform/hp-wmi/rgb_zones 2>/dev/null || true'"
